STRIPE_SECRET_KEY=sk_test_your_key_here
# Google sign-in for visitors (see GOOGLE-LOGIN-SETUP.txt)
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Emails (welcome email, receipts, order links). Option A: Gmail or any SMTP server
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=yourname@gmail.com
# SMTP_PASS=your-16-letter-app-password
# Option B: Resend. Without either, emails are only saved in Admin > Emails.
# RESEND_API_KEY=re_your_key
# MAIL_FROM=Trader WorkStation <orders@yourdomain.com>
# Optional - AI voice for strategies (Admin > Strategies > "Generate AI audio"). Without it you can upload audio files.
# OPENAI_API_KEY=sk-your_key
# TTS_VOICE=alloy
# Optional - website assistant. It works without a key (answers from your site content). With a key it writes full AI answers.
# ANTHROPIC_API_KEY=sk-ant-your_key
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_DAILY_MAX=500
# ASSISTANT=off
# Optional - live market ticker. Crypto works without a key. For US stocks, get a free key at https://finnhub.io
# FINNHUB_API_KEY=your_key
# TICKER_STOCKS=SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN
# TICKER_CRYPTO=BTC,ETH,SOL,BNB,XRP
# TICKER=off
# Optional - other settings
# PORT=3000
# BASE_URL=https://www.example.com
# ADMIN_TOKEN=choose-your-own
# REFUND_DAYS=14
# MAX_VIDEO_MB=1000
# STRIPE_WEBHOOK_SECRET=whsec_...
