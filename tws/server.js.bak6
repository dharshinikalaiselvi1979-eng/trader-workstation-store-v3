});
app.get('/api/admin/export.csv', admin, (req, res) => {
  const q = v => '"' + String(v == null ? '' : v).replace(/"/g, '""') + '"';
  const rows = [['id', 'created', 'paid', 'email', 'status', 'items', 'total_usd', 'code', 'discount_usd']].concat(db.orders.map(o =>
    [o.id, o.created_at, o.paid_at, o.email, o.status, o.items.map(i => i.name + ' x' + i.quantity).join('; '), (o.amount / 100).toFixed(2), o.code, ((o.discount || 0) / 100).toFixed(2)]));
  res.type('text/csv').send(rows.map(r => r.map(q).join(',')).join('\n'));
});
app.get('/api/admin/sessions', admin, (req, res) => {
  const t = new Date();
  res.json({
    interest: db.inbox.filter(m => m.kind === 'live' && !m.sessionId).length, items: db.sessions.slice().sort((a, b) => b.start.localeCompare(a.start)).map(x => Object.assign({}, x, {
      end: sessEnd(x).toISOString(), when: whenText(x), spotsLeft: spotsLeft(x), state: x.cancelled ? 'cancelled' : t >= sessEnd(x) ? 'ended' : t >= new Date(x.start) ? 'live' : 'upcoming',
      registrants: regsOf(x).map(m => ({ name: m.name, email: m.email, created_at: m.created_at, message: m.message }))
    }))
  });
