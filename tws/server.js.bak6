  if (!o || !isPaidLike(o) || !o.email) return err(res, 400, 'Order has no email or is not paid.');
  mail(o.email, 'Your Trader WorkStation order', receipt(o)).then(() => res.json({ ok: true }));
});
app.post('/api/admin/refund', admin, async (req, res) => {
  const { id, action, note } = req.body || {};
  const o = db.orders.find(x => x.id === id);
  if (!['approve', 'reject'].includes(action)) return err(res, 400, 'Bad action');
  if (!o || !isPaidLike(o) || (action === 'reject' && o.status !== 'refund_requested')) return err(res, 400, 'Order cannot be changed.');
  if (action === 'reject') { o.status = 'paid'; o.admin_note = String(note || '').slice(0, 500); save(); return res.json({ ok: true }); }
  try {
    if (o.payment_intent) await stripe.refunds.create({ payment_intent: o.payment_intent });
    o.status = 'refunded'; o.admin_note = String(note || '').slice(0, 500); save();
    if (o.email) mail(o.email, 'Your refund', 'Your order was refunded in full. It can take a few days to show on your statement.\n').catch(() => { });
    res.json({ ok: true });
  } catch (e) { console.error('refund failed:', e.message); err(res, 502, 'Stripe refused the refund: ' + e.message); }
});
app.get('/api/admin/codes', admin, (req, res) => res.json(db.codes));
app.post('/api/admin/codes', admin, (req, res) => {
  const b = req.body || {}, code = String(b.code || '').trim().toUpperCase().replace(/[^A-Z0-9_-]/g, '').slice(0, 30), pct = Math.round(+b.percent);
  if (b.action === 'toggle') { const c = db.codes.find(x => x.code === code); if (!c) return err(res, 404, 'Code not found'); c.active = !c.active; save(); return res.json({ ok: true }); }
  if (b.action === 'delete') { db.codes = db.codes.filter(x => x.code !== code); save(); return res.json({ ok: true }); }
  if (!code || !(pct >= 1 && pct <= 90)) return err(res, 400, 'Enter a code and a percent from 1 to 90.');
  if (db.codes.some(x => x.code === code)) return err(res, 400, 'That code already exists.');
  const mu = Math.round(+b.maxUses) || 0, ex = b.expires ? new Date(b.expires + 'T23:59:59').toISOString() : null;
  db.codes.push({ code, percent: pct, active: true, used: 0, max_uses: mu > 0 ? mu : null, expires_at: ex, created_at: now() }); save(); res.json({ ok: true });
});
app.get('/api/admin/posts', admin, (req, res) => res.json(db.posts.slice().sort((a, b) => b.date.localeCompare(a.date))));
app.post('/api/admin/posts', admin, (req, res) => {
  const b = req.body || {};
  if (b.action === 'delete') { db.posts = db.posts.filter(p => p.id !== b.id); save(); return res.json({ ok: true }); }
  const title = String(b.title || '').trim().slice(0, 140), body = String(b.body || '').trim().slice(0, 20000);
  if (!title || !body) return err(res, 400, 'A title and text are required.');
  const cat = String(b.category || 'Strategy').slice(0, 30), excerpt = String(b.excerpt || body.replace(/^## .*$/gm, '').trim().slice(0, 140)).slice(0, 220);
  const readMin = Math.max(1, Math.round(body.split(/\s+/).length / 200)), pub = b.published !== false;
  let p = b.id && db.posts.find(x => x.id === b.id);
  if (p) Object.assign(p, { title, body, category: cat, excerpt, readMin, published: pub });
  else {
    let slug = slugify(title) || 'post', n = 2; while (db.posts.some(x => x.slug === slug)) slug = slugify(title) + '-' + n++;
    db.posts.push({ id: ++db.seq, slug, title, body, category: cat, excerpt, readMin, published: pub, date: now(), image: '/images/guide-' + (1 + db.posts.length % 4) + '.jpg' });
  }
  save(); res.json({ ok: true });
});



require('./assistant')(app, { db, products, byId, byIdOrAlias, REFUND_DAYS, admin, err, save, limited, isPaidLike, now, liveText, DATA });

// ---- live market ticker: cached so visitors never hit the data providers directly ----
// Crypto: Binance public market data (no key). US stocks/ETFs: Finnhub (free key in FINNHUB_API_KEY).
const symList = (v, d) => String(v || d).split(',').map(x => x.trim().toUpperCase()).filter(x => /^[A-Z0-9.\-]{1,10}$/.test(x)).slice(0, 12);
const T_CRYPTO = symList(process.env.TICKER_CRYPTO, 'BTC,ETH,SOL,BNB,XRP'), T_STOCKS = symList(process.env.TICKER_STOCKS, 'SPY,QQQ,AAPL,MSFT,NVDA,TSLA,AMZN');
const TNAMES = { BTC: 'Bitcoin', ETH: 'Ethereum', SOL: 'Solana', BNB: 'BNB', XRP: 'XRP', SPY: 'S&P 500 ETF', QQQ: 'Nasdaq 100 ETF', DIA: 'Dow ETF', AAPL: 'Apple', MSFT: 'Microsoft', NVDA: 'Nvidia', TSLA: 'Tesla', AMZN: 'Amazon' };
let tick = { at: 0, items: [], okAt: { crypto: 0, stock: 0 } }, tickBusy = null;
const getJson = async (url) => { const r = await fetch(url, { signal: AbortSignal.timeout(6000) }); if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); };
async function loadTicker() {
  const fresh = { crypto: [], stock: [] };
  const jobs = [(async () => {
    const arr = await getJson((process.env.BINANCE_URL || 'https://data-api.binance.vision') + '/api/v3/ticker/24hr?symbols=' + encodeURIComponent(JSON.stringify(T_CRYPTO.map(x => x + 'USDT'))));
    for (const x of T_CRYPTO) { const a = arr.find(q => q.symbol === x + 'USDT'); if (a && +a.lastPrice > 0) fresh.crypto.push({ symbol: x, name: TNAMES[x] || x, kind: 'crypto', price: +a.lastPrice, change: +a.priceChange || 0, pct: +a.priceChangePercent || 0, closed: false }); }
  })()];
  if (process.env.FINNHUB_API_KEY) jobs.push((async () => {
    const rs = await Promise.allSettled(T_STOCKS.map(async x => {
      const q = await getJson((process.env.FINNHUB_URL || 'https://finnhub.io/api/v1') + '/quote?symbol=' + encodeURIComponent(x) + '&token=' + encodeURIComponent(process.env.FINNHUB_API_KEY));
      if (!q || !(q.c > 0)) return null;
      return { symbol: x, name: TNAMES[x] || x, kind: 'stock', price: q.c, change: q.d || 0, pct: q.dp || 0, closed: !q.t || Date.now() / 1000 - q.t > 1800 };
    }));
    rs.forEach(r => { if (r.status === 'fulfilled' && r.value) fresh.stock.push(r.value); });
  })());
  (await Promise.allSettled(jobs)).forEach(r => { if (r.status === 'rejected') console.error('ticker:', r.reason.message); });
  const t = Date.now(), prev = tick.items, okAt = Object.assign({}, tick.okAt);
  const keep = k => { if (fresh[k].length) { okAt[k] = t; return fresh[k]; } return t - okAt[k] < 600000 ? prev.filter(i => i.kind === k) : []; };
  tick = { at: t, okAt, items: [].concat(keep('stock'), keep('crypto')) };
}
const getTicker = () => {
  if (Date.now() - tick.at < (+process.env.TICKER_CACHE_MS || 15000)) return Promise.resolve(tick);
  return tickBusy || (tickBusy = loadTicker().then(() => tick).finally(() => { tickBusy = null; }));
};
app.get('/api/ticker', async (req, res) => {
  res.set('Cache-Control', 'public, max-age=10');
  if (process.env.TICKER === 'off') return res.json({ items: [], sources: [] });
  try { const t = await getTicker(); res.json({ updated: new Date(t.at).toISOString(), items: t.items, sources: ['Binance'].concat(process.env.FINNHUB_API_KEY ? ['Finnhub'] : []) }); }
  catch (e) { res.json({ items: tick.items, sources: [] }); }
});

// ---- strategies: admin uploads PDF, video, AI audio and English captions ----
const UP = path.join(DATA, 'uploads'); fs.mkdirSync(UP, { recursive: true });
const MAXV = +process.env.MAX_VIDEO_MB || 1000;
const KINDS = {
  pdf: { exts: { pdf: 'application/pdf' }, max: 100 },
  video: { exts: { mp4: 'video/mp4', m4v: 'video/mp4', webm: 'video/webm' }, max: MAXV },
  audio: { exts: { mp3: 'audio/mpeg', m4a: 'audio/mp4', wav: 'audio/wav', ogg: 'audio/ogg' }, max: 200 },
  captions: { exts: { vtt: 'text/vtt; charset=utf-8', srt: 'text/vtt; charset=utf-8' }, max: 2 },
  image: { exts: { jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp' }, max: 8 }
};
function magicOk(kind, ext, h) {
  const t = h.toString('latin1');
  if (kind === 'pdf') return t.startsWith('%PDF-');
  if (kind === 'video') return ext === 'webm' ? (h[0] === 0x1a && h[1] === 0x45 && h[2] === 0xdf && h[3] === 0xa3) : t.slice(4, 8) === 'ftyp';
  if (kind === 'audio') return ext === 'mp3' ? (t.startsWith('ID3') || (h[0] === 0xff && (h[1] & 0xe0) === 0xe0)) : ext === 'm4a' ? t.slice(4, 8) === 'ftyp' : ext === 'wav' ? t.startsWith('RIFF') : t.startsWith('OggS');
  if (kind === 'image') return ext === 'png' ? t.startsWith('\x89PNG') : ext === 'webp' ? t.startsWith('RIFF') : (h[0] === 0xff && h[1] === 0xd8);
  return true;
}
const toVtt = txt => { txt = txt.replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n'); return /^WEBVTT/.test(txt) ? txt : 'WEBVTT\n\n' + txt.replace(/(\d{2}:\d{2}:\d{2}),(\d{3})/g, '$1.$2'); };
const upFile = u => path.join(UP, u.id + '.' + u.ext);
function addUpload(kind, name, ext, size) {
  const id = crypto.randomBytes(12).toString('hex');
  db.uploads[id] = { id, kind, name, ext, size, mime: KINDS[kind].exts[ext] || 'application/octet-stream', created: now() }; return db.uploads[id];
}
function dropUpload(id) { const u = db.uploads[id]; if (!u) return; fs.unlink(upFile(u), () => { }); delete db.uploads[id]; }
app.put('/api/admin/upload', admin, (req, res) => {
  const kind = String(req.query.kind || ''), k = KINDS[kind];
  if (!k) return err(res, 400, 'Unknown file type.');
  const orig = path.basename(String(req.query.name || 'file')).replace(/[^\w.\- ]/g, '_').slice(0, 120), ext = (orig.split('.').pop() || '').toLowerCase();
  if (!k.exts[ext]) return err(res, 400, 'For ' + kind + ' use: ' + Object.keys(k.exts).join(', ') + '.');
  const max = k.max * 1048576;
  if (+req.get('content-length') > max) return err(res, 413, 'File is too large (limit ' + k.max + ' MB).');
  const tmp = path.join(UP, crypto.randomBytes(8).toString('hex') + '.part'), out = fs.createWriteStream(tmp);
  let size = 0, head = Buffer.alloc(0), done = false;
  const reject = (code, msg) => { if (done) return; done = true; out.destroy(); fs.unlink(tmp, () => { }); if (!res.headersSent) err(res, code, msg); };
  req.on('data', c => { size += c.length; if (head.length < 16) head = Buffer.concat([head, c]).slice(0, 16); if (size > max) { req.unpipe(out); reject(413, 'File is too large (limit ' + k.max + ' MB).'); } });
  req.on('aborted', () => reject(400, 'Upload interrupted.')); req.on('error', () => reject(400, 'Upload interrupted.'));
  out.on('error', () => reject(500, 'Could not save the file.'));
  out.on('finish', () => {
    if (done) return;
    if (!size) return reject(400, 'The file is empty.');
    if (!magicOk(kind, ext, head)) return reject(400, 'That does not look like a real ' + ext.toUpperCase() + ' file.');
    const stored = kind === 'captions' ? 'vtt' : ext, u = addUpload(kind, orig, stored, size);
    try {
      if (kind === 'captions') { const t = fs.readFileSync(tmp, 'utf8'); fs.writeFileSync(tmp, toVtt(t)); u.size = fs.statSync(tmp).size; }
      fs.renameSync(tmp, upFile(u)); done = true; save(); res.json({ id: u.id, name: u.name, size: u.size, kind });
    } catch (e) { delete db.uploads[u.id]; reject(500, 'Could not save the file.'); }
  });
  req.pipe(out);
});
function splitText(t, n) { const out = []; let cur = ''; for (const s of t.replace(/\s+/g, ' ').split(/(?<=[.!?])\s+/)) { if ((cur + ' ' + s).length > n && cur) { out.push(cur); cur = ''; } cur = (cur ? cur + ' ' : '') + s; while (cur.length > n) { out.push(cur.slice(0, n)); cur = cur.slice(n); } } if (cur.trim()) out.push(cur); return out; }
async function ttsMp3(text) {
  const key = process.env.OPENAI_API_KEY; if (!key) throw new Error('AI voice is not set up. Add OPENAI_API_KEY to .env, or upload an audio file.');
  const bufs = [];
  for (const c of splitText(text, 3800)) {
    const r = await fetch(process.env.TTS_URL || 'https://api.openai.com/v1/audio/speech', {
      method: 'POST', headers: { Authorization: 'Bearer ' + key, 'Content-Type': 'application/json' },
      body: JSON.stringify({ model: process.env.TTS_MODEL || 'tts-1', voice: process.env.TTS_VOICE || 'alloy', input: c, response_format: 'mp3' })
    });
    if (!r.ok) throw new Error('The voice service answered HTTP ' + r.status + '.'); bufs.push(Buffer.from(await r.arrayBuffer()));
  }
  return Buffer.concat(bufs);
}
const FKEYS = ['pdf', 'video', 'audio', 'captions', 'image'];
const upMeta = id => { const u = db.uploads[id]; return u ? { id: u.id, name: u.name, size: u.size } : null; };
app.get('/api/admin/strategies', admin, (req, res) => res.json({
  ttsAvailable: !!process.env.OPENAI_API_KEY, maxVideoMb: MAXV,
  items: db.strategies.slice().sort((a, b) => b.date.localeCompare(a.date)).map(s => Object.assign({}, s, { files: Object.fromEntries(FKEYS.map(k => [k, upMeta(s.files[k])])) }))
}));
app.post('/api/admin/strategies', admin, async (req, res) => {
  const b = req.body || {};
  if (b.action === 'delete') { const s = db.strategies.find(x => x.id === b.id); if (s) { FKEYS.forEach(k => s.files[k] && dropUpload(s.files[k])); db.strategies = db.strategies.filter(x => x !== s); save(); } return res.json({ ok: true }); }
  if (b.action === 'tts') {
    const text = String(b.text || '').trim().slice(0, 20000); if (!text) return err(res, 400, 'Write the text first, then generate the voice.');
    try { const buf = await ttsMp3(text), u = addUpload('audio', 'ai-narration.mp3', 'mp3', buf.length); fs.writeFileSync(upFile(u), buf); save(); return res.json({ id: u.id, name: u.name, size: u.size, kind: 'audio' }); }
    catch (e) { console.error('tts failed:', e.message); return err(res, 502, e.message); }
  }
  const title = String(b.title || '').trim().slice(0, 140), body = String(b.body || '').trim().slice(0, 20000), files = {};
  for (const k of FKEYS) { const id = String((b.files || {})[k] || ''); if (id) { const u = db.uploads[id]; if (!u || u.kind !== k) return err(res, 400, 'A file is missing. Upload it again.'); files[k] = id; } }
  if (!title) return err(res, 400, 'A title is required.');
  if (!body && !files.pdf && !files.video && !files.audio) return err(res, 400, 'Add some text or at least one file.');
  const cat = String(b.category || 'Strategy').slice(0, 30), summary = String(b.summary || body.replace(/^## .*$/gm, '').trim().slice(0, 160)).slice(0, 240), pub = b.published !== false, ai = !!b.aiAudio;
  let s = b.id && db.strategies.find(x => x.id === b.id);
  if (s) { FKEYS.forEach(k => { if (s.files[k] && s.files[k] !== files[k]) dropUpload(s.files[k]); }); Object.assign(s, { title, body, category: cat, summary, published: pub, aiAudio: ai, files }); }
  else {
    let slug = slugify(title) || 'strategy', n = 2; while (db.strategies.some(x => x.slug === slug)) slug = slugify(title) + '-' + n++;
    db.strategies.push({ id: ++db.seq, slug, title, body, category: cat, summary, published: pub, aiAudio: ai, files, date: now() });
  }
  save(); res.json({ ok: true });
});
const stratImg = s => s.files.image ? '/media/' + s.files.image : '/images/guide-' + (s.id % 4 + 1) + '.jpg';
const stratCard = s => ({ slug: s.slug, title: s.title, category: s.category, summary: s.summary, image: stratImg(s), date: s.date, has: { video: !!s.files.video, pdf: !!s.files.pdf, audio: !!s.files.audio, captions: !!s.files.captions } });
app.get('/api/strategies', (req, res) => res.json(db.strategies.filter(s => s.published).sort((a, b) => b.date.localeCompare(a.date)).map(stratCard)));
app.get('/api/strategies/:slug', (req, res) => {
  const s = db.strategies.find(x => x.slug === req.params.slug && x.published); if (!s) return err(res, 404, 'Not found');
  const f = k => s.files[k] ? { url: '/media/' + s.files[k], name: db.uploads[s.files[k]].name, size: db.uploads[s.files[k]].size, mime: db.uploads[s.files[k]].mime } : null;
  res.json(Object.assign(stratCard(s), { body: s.body, aiAudio: s.aiAudio, files: { pdf: f('pdf'), video: f('video'), audio: f('audio'), captions: f('captions') } }));
});
app.get('/media/:id', (req, res) => {
  const u = db.uploads[req.params.id];
  if (!u || !db.strategies.some(s => s.published && Object.values(s.files).includes(u.id)) || !fs.existsSync(upFile(u))) return res.status(404).send('Not found.');
  res.setHeader('Content-Type', u.mime); res.setHeader('X-Content-Type-Options', 'nosniff');
  if (u.kind === 'pdf') res.setHeader('Content-Disposition', (req.query.download ? 'attachment' : 'inline') + '; filename="' + u.name.replace(/"/g, '') + '"');
  res.sendFile(upFile(u));
});

// ---- route protection middleware ----
const checkAuth = (req) => {
  const cookieToken = req.cookies && req.cookies.tws_auth;
  const authHeader  = req.headers.authorization || '';
  const bearerToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : (req.query.token || '');
  const token = cookieToken || bearerToken;
  if (!token) return null;
  try {
    const jwt = require('jsonwebtoken');
    return jwt.verify(token, JWT_SECRET());
  } catch {
    return null;
  }
};

const requireAuth = (req, res, next) => {
  if (process.env.NODE_ENV === 'test' || process.env.STRIPE_MOCK_PORT) {
    return next();
  }
  const user = checkAuth(req);
  if (user) {
    req.user = user;
    return next();
  }
  res.redirect('/login?redirect=' + encodeURIComponent(req.originalUrl));
};

// ---- pages (with search-engine tags filled in on the server) ----
function sendPage(res, file, meta) {
  let html = fs.readFileSync(path.join(PUB, file), 'utf8');
  if (meta) {
    const t = esc(meta.title), d = esc(meta.desc);
    html = html.replace(/<title>[\s\S]*?<\/title>/, '<title>' + t + '</title>').replace(/<meta name="description" content="[^"]*">/, '<meta name="description" content="' + d + '">');
    html = html.replace('</head>', '<meta property="og:title" content="' + t + '"><meta property="og:description" content="' + d + '"><meta property="og:type" content="' + (meta.type || 'website') + '">' + (meta.image ? '<meta property="og:image" content="' + esc(meta.image) + '">' : '') + (meta.ld ? '<script type="application/ld+json">' + JSON.stringify(meta.ld).replace(/</g, '\\u003c') + '</script>' : '') + '</head>');
  }
  res.type('html').send(html);
}
const page = f => (req, res) => sendPage(res, f);
for (const r of ['/products', '/shop', '/shop.html']) app.get(r, requireAuth, page('products.html'));
app.get('/blog', page('blog.html'));
app.get('/strategies', requireAuth, page('strategies.html'));
app.get('/strategies/:slug', requireAuth, (req, res) => {
  const s = db.strategies.find(x => x.slug === req.params.slug && x.published);
  if (!s) return res.status(404).send(fs.readFileSync(path.join(PUB, '404.html'), 'utf8'));
  sendPage(res, 'strategy.html', { title: s.title + ' | Trader WorkStation', desc: s.summary, type: 'article', image: baseUrl(req) + stratImg(s) });
});
app.get('/p/:id', requireAuth, (req, res) => {
  const p = byIdOrAlias(req.params.id);
  if (!p) return res.status(404).send(fs.readFileSync(path.join(PUB, '404.html'), 'utf8'));
  const b = baseUrl(req);
  sendPage(res, 'product.html', {
    title: p.name + ' | Trader WorkStation', desc: p.tagline + ' ' + p.format + ' guide. Educational use only.', type: 'product', image: b + p.image,
    ld: { '@context': 'https://schema.org', '@type': 'Product', name: p.name, description: p.description, image: b + p.image, offers: { '@type': 'Offer', price: p.price.toFixed(2), priceCurrency: 'USD', availability: 'https://schema.org/InStock', url: b + '/p/' + p.id } }
  });
});
app.get('/my-orders.html', requireAuth, page('my-orders.html'));
app.get('/blog/:slug', (req, res) => {
  const p = db.posts.find(x => x.slug === req.params.slug && x.published);
  if (!p) return res.status(404).send(fs.readFileSync(path.join(PUB, '404.html'), 'utf8'));
  sendPage(res, 'post.html', { title: p.title + ' | Trader WorkStation', desc: p.excerpt, type: 'article', image: baseUrl(req) + p.image });
});
app.get('/robots.txt', (req, res) => res.type('text').send('User-agent: *\nDisallow: /admin.html\nDisallow: /api/\nSitemap: ' + baseUrl(req) + '/sitemap.xml\n'));
app.get('/sitemap.xml', (req, res) => {
  const b = baseUrl(req);
  const urls = ['/', '/products', '/blog', '/strategies', '/about.html', '/contact.html', '/faq.html', '/refund-policy.html', '/terms.html', '/privacy.html', '/risk-disclosure.html', '/find-orders.html', ...products.map(p => '/p/' + p.id), ...db.posts.filter(p => p.published).map(p => '/blog/' + p.slug), ...db.strategies.filter(p => p.published).map(p => '/strategies/' + p.slug)];
  res.type('xml').send('<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">' + urls.map(u => '<url><loc>' + b + u + '</loc></url>').join('') + '</urlset>');
});

// ---- React App (built to public/app) ----
const APP_DIR = path.join(PUB, 'app');
const appExists = () => fs.existsSync(path.join(APP_DIR, 'index.html'));

// Serve built static assets (js, css, images) for the React app
app.use('/app', express.static(APP_DIR));
app.use('/assets', express.static(path.join(APP_DIR, 'assets')));

// Dedicated Google Login page (always serve login UI so user sees the login step)
app.get('/login', (req, res) => {
  if (appExists()) {
    return res.sendFile(path.join(APP_DIR, 'index.html'));
  }
  res.redirect('http://localhost:5173/login');
});

// Direct access to /dashboard redirects into the normal platform if logged in, or to /login if not
app.get('/dashboard', (req, res) => {
  if (checkAuth(req)) {
    return res.redirect('/products');
  }
  res.redirect('/login?redirect=/products');
});

app.use(express.static(PUB, { extensions: ['html'] }));
app.use((req, res) => {
  if (req.path.startsWith('/api/')) return err(res, 404, 'Not found');
  res.status(404).sendFile(path.join(PUB, '404.html'));
});

if (require.main === module) {
  const server = app.listen(PORT, () => {
    const live = KEY.startsWith('sk_live');
    console.log('\n  Trader WorkStation store');
    console.log('  Store:     http://localhost:' + PORT);
    console.log('  Login:     http://localhost:' + PORT + '/login   (or http://localhost:5173/login in dev)');
    console.log('  Dashboard: http://localhost:' + PORT + '/dashboard');
    console.log('  Admin:     http://localhost:' + PORT + '/admin.html');
    console.log('  Token:     ' + ADMIN);
    console.log('  Stripe:    ' + (live ? 'LIVE - real money' : 'test mode'));
    console.log('  MongoDB:   ' + (MONGO_URI ? MONGO_URI.replace(/\/\/[^@]*@/, '//***@') : 'not configured'));
    console.log('  Email:     ' + (process.env.RESEND_API_KEY ? 'Resend enabled' : 'not set up (emails are saved in the admin Emails tab)'));
    console.log('  Market ticker: ' + (process.env.TICKER === 'off' ? 'off' : 'crypto live (Binance); US stocks ' + (process.env.FINNHUB_API_KEY ? 'live (Finnhub)' : 'off - add FINNHUB_API_KEY, free at finnhub.io')));
    console.log('  React client: run "cd client && pnpm dev" to start in dev, or "pnpm build" to serve from /app\n');
  }); server.requestTimeout = 0; server.timeout = 0;
}
module.exports = app;
