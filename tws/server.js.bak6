app.post('/api/admin/sessions', admin, async (req, res) => {
  const b = req.body || {}, find = () => db.sessions.find(x => x.id === b.id);
  if (b.action === 'delete') { db.sessions = db.sessions.filter(x => x.id !== b.id); save(); return res.json({ ok: true }); }
  if (b.action === 'cancel') {
    const x = find(); if (!x) return err(res, 404, 'Session not found');
    x.cancelled = !x.cancelled; save();
    if (x.cancelled && b.notify) for (const m of regsOf(x)) await mail(m.email, 'Live session cancelled: ' + x.title, 'The live session "' + x.title + '" (' + whenText(x) + ') has been cancelled. We will email you when a new date is set.\n\nTrader WorkStation\n');
    return res.json({ ok: true });
  }
  if (b.action === 'remind') {
    const x = find(); if (!x) return err(res, 404, 'Session not found');
    const regs = regsOf(x);
    for (const m of regs) await mail(m.email, 'Reminder: ' + x.title, 'Hi ' + m.name + ',\n\n"' + x.title + '" starts ' + whenText(x) + '.\n' + (x.joinUrl ? 'Join here: ' + x.joinUrl + '\n' : 'We will send the join link shortly.\n') + '\nTrader WorkStation\n');
    x.reminded_at = now(); save(); return res.json({ ok: true, sent: regs.length });
  }
  const start = new Date(b.start); if (isNaN(start)) return err(res, 400, 'Choose a valid date and time.');
  const joinUrl = String(b.joinUrl || '').trim(); if (joinUrl && !/^https?:\/\/\S+$/i.test(joinUrl)) return err(res, 400, 'The join link must start with http:// or https://');
  const rec = {
    title: String(b.title || '').trim().slice(0, 100) || 'Live session', start: start.toISOString(), tz: validTz(b.tz) ? b.tz : 'UTC',
    durationMin: Math.min(480, Math.max(15, Math.round(+b.durationMin) || 60)), capacity: Math.max(0, Math.min(10000, Math.round(+b.capacity) || 0)),
    description: String(b.description || '').trim().slice(0, 500), joinUrl, open: b.open !== false
  };
  const x = b.id && find();
  if (x) Object.assign(x, rec); else db.sessions.push(Object.assign({ id: ++db.seq, cancelled: false, created_at: now() }, rec));
  save(); res.json({ ok: true });
});

// ---- Stripe connection check and payment history (read-only, straight from Stripe) ----
const stripeMode = () => process.env.STRIPE_MOCK_PORT ? 'mock' : /^(sk|rk)_live_/.test(KEY) ? 'live' : 'test';
app.get('/api/admin/stripe', admin, async (req, res) => {
  const mode = stripeMode(), base = baseUrl(req), out = { mode, keyType: KEY.slice(0, 7), webhook: { enabled: !!process.env.STRIPE_WEBHOOK_SECRET, url: base + '/api/webhook' }, baseUrl: base, refundDays: REFUND_DAYS, warnings: [] };
  if (mode === 'live' && (/localhost|127\.0\.0\.1/.test(base) || !/^https:/.test(base))) out.warnings.push('Your site address is ' + base + '. For real payments it should be your public https address. Set BASE_URL in .env.');
  if (mode === 'live' && !process.env.STRIPE_WEBHOOK_SECRET) out.warnings.push('No webhook is set up. Orders still confirm when the buyer lands on the order page or you open the admin, but a webhook is safer (see STRIPE-SETUP.txt).');
  try {
    const a = await stripe.accounts.retrieve();
    out.account = { id: a.id, country: a.country, email: a.email, name: (a.business_profile && a.business_profile.name) || (a.settings && a.settings.dashboard && a.settings.dashboard.display_name) || '', charges_enabled: !!a.charges_enabled, payouts_enabled: !!a.payouts_enabled, details_submitted: !!a.details_submitted, currency: a.default_currency };
  } catch (e) { out.error = String(e.message || 'Could not reach Stripe').slice(0, 300); }
  res.json(out);
});
app.get('/api/admin/stripe/payments', admin, async (req, res) => {
  try {
    const list = await stripe.charges.list({ limit: 40 }), mode = stripeMode();
    res.json({
      mode, items: list.data.map(c => {
        const o = c.payment_intent && db.orders.find(x => x.payment_intent === (typeof c.payment_intent === 'string' ? c.payment_intent : c.payment_intent.id));
        const pi = typeof c.payment_intent === 'string' ? c.payment_intent : c.payment_intent && c.payment_intent.id;
        return { id: c.id, paymentIntent: pi || '', amount: c.amount, refunded: c.amount_refunded || 0, currency: c.currency, status: c.status, paid: !!c.paid, email: (c.billing_details && c.billing_details.email) || c.receipt_email || '', created: new Date(c.created * 1000).toISOString(), receipt: c.receipt_url || '', orderId: o ? o.id : null };
      })
    });
  } catch (e) { err(res, 502, 'Stripe said: ' + String(e.message || 'could not load payments').slice(0, 200)); }
});
