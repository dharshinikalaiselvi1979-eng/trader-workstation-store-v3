require('dotenv').config();
const express = require('express'), fs = require('fs'), path = require('path'), crypto = require('crypto'), Stripe = require('stripe');
const cookieParser = require('cookie-parser');
const mongoose = require('mongoose');
const User = require('./models/User');

// ---- MongoDB connection (non-blocking: store features still work if Mongo is unavailable) ----
const MONGO_URI = process.env.MONGO_URI;
if (MONGO_URI) {
  mongoose.connect(MONGO_URI)
    .then(() => console.log('  MongoDB: connected to', MONGO_URI.replace(/\/\/[^@]*@/, '//***@')))
    .catch(e => console.warn('  MongoDB: could not connect –', e.message, '(Google login unavailable)'));
}

const KEY = process.env.STRIPE_SECRET_KEY;
if (!KEY) { console.error('Missing STRIPE_SECRET_KEY. Copy .env.example to .env and add your key.'); process.exit(1); }
const sopts = process.env.STRIPE_MOCK_PORT ? { host: 'localhost', port: +process.env.STRIPE_MOCK_PORT, protocol: 'http' } : {};
const stripe = new Stripe(KEY, sopts);
const PORT = +process.env.PORT || 3000;
const REFUND_DAYS = +process.env.REFUND_DAYS || 14; // one source; pages read it from /api/config
const PUB = path.join(__dirname, 'public'), DATA = path.resolve(process.env.DATA_DIR || path.join(__dirname, 'data')), DL = path.resolve(process.env.DL_DIR || path.join(__dirname, 'downloads'));
const products = JSON.parse(fs.readFileSync(path.join(__dirname, 'products.json'), 'utf8'));
const byId = id => products.find(p => p.id === id);
const byIdOrAlias = id => products.find(p => p.id === id || p.alias === id);

// ---- storage: one JSON file, atomic writes ----
fs.mkdirSync(DATA, { recursive: true }); fs.mkdirSync(DL, { recursive: true });
const FILE = path.join(DATA, 'store.json');
let db = { seq: 0, orders: [], inbox: [], codes: [], posts: null, outbox: [], lookups: [], strategies: [], uploads: {}, sessions: [], users: [] };
try { db = Object.assign(db, JSON.parse(fs.readFileSync(FILE, 'utf8'))); } catch { }
if (!Array.isArray(db.users)) db.users = [];
const save = () => { fs.writeFileSync(FILE + '.tmp', JSON.stringify(db)); fs.renameSync(FILE + '.tmp', FILE); };
if (!db.posts) {
  const seed = JSON.parse(fs.readFileSync(path.join(__dirname, 'posts-seed.json'), 'utf8'));
  db.posts = seed.map((p, i) => Object.assign({ id: ++db.seq, published: true, date: new Date(Date.now() - i * 864e5 * 3).toISOString() }, p));
  save();
}
let ADMIN = process.env.ADMIN_TOKEN;
const TOKFILE = path.join(DATA, 'admin-token.txt');
if (!ADMIN) { try { ADMIN = fs.readFileSync(TOKFILE, 'utf8').trim(); } catch { } }
if (!ADMIN) { ADMIN = crypto.randomBytes(12).toString('hex'); fs.writeFileSync(TOKFILE, ADMIN); }

// ---- helpers ----
const now = () => new Date().toISOString();
const money = c => '$' + (c / 100).toFixed(2);
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const isPaidLike = o => o.status === 'paid' || o.status === 'refund_requested';
const baseUrl = req => {
  const b = process.env.BASE_URL;
  if (b && !/localhost|127\.0\.0\.1/.test(b)) return b.replace(/\/$/, '');
  return req.protocol + '://' + req.get('host');
};
const key16 = () => crypto.randomBytes(8).toString('hex').toUpperCase().match(/.{4}/g).join('-');
const refundUntil = o => new Date(new Date(o.paid_at).getTime() + REFUND_DAYS * 864e5);
const refundable = o => o.status === 'paid' && o.paid_at && new Date() < refundUntil(o);
const slugify = s => String(s).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80);

// ---- email: Nodemailer (Gmail) or Resend if configured, always logged in outbox ----
let transporter = null;
if (process.env.MAIL_USER && process.env.MAIL_PASS) {
  try {
    const nodemailer = require('nodemailer');
    transporter = nodemailer.createTransport({
      service: 'gmail',
      auth: { user: process.env.MAIL_USER, pass: process.env.MAIL_PASS }
    });
  } catch (e) {
    console.error('Nodemailer init error:', e.message);
  }
}

async function mail(to, subject, text, html) {
  const rec = { id: ++db.seq, to, subject, text, html: html || null, sent: false, error: '', created_at: now() };
  db.outbox.push(rec); if (db.outbox.length > 200) db.outbox.shift();
  if (transporter && process.env.MAIL_USER) {
    try {
      await transporter.sendMail({
        from: `"TraderWorkStation" <${process.env.MAIL_USER}>`,
        to,
        subject,
        text,
        html: html || undefined
      });
      rec.sent = true;
    } catch (e) {
      rec.error = 'Gmail error: ' + e.message;
    }
  } else if (process.env.RESEND_API_KEY) {
    try {
      const r = await fetch('https://api.resend.com/emails', {
        method: 'POST', headers: { Authorization: 'Bearer ' + process.env.RESEND_API_KEY, 'Content-Type': 'application/json' },
        body: JSON.stringify({ from: process.env.MAIL_FROM || 'Trader WorkStation <onboarding@resend.dev>', to: [to], subject, text, html: html || undefined })
      });
      if (r.ok) rec.sent = true; else rec.error = 'Email service answered HTTP ' + r.status;
    } catch (e) { rec.error = e.message; }
  } else rec.error = 'Email service not set up. Message saved here only.';
  try { save(); } catch { }
}

async function sendWelcomeEmail(to, name) {
  const cleanName = esc(name || 'Trader');
  const html = `
    <div style="font-family:Arial,sans-serif;max-width:520px;padding:24px;border:1px solid #e2e8f0;border-radius:12px;background:#ffffff;color:#0f172a">
      <h2 style="color:#0f172a;margin-top:0">Welcome to TraderWorkStation, ${cleanName}!</h2>
      <p style="color:#475569;font-size:15px;line-height:1.6">Thanks for joining us. Explore our trading indicators and tools, and join our free live classes on YouTube.</p>
      <p style="color:#475569;font-size:15px;line-height:1.6">Happy trading,<br/><strong>Team TraderWorkStation</strong></p>
    </div>`;
  const text = `Welcome to TraderWorkStation, ${cleanName}!\n\nThanks for joining us. Explore our trading indicators and tools, and join our free live classes on YouTube.\n\nHappy trading,\nTeam TraderWorkStation`;
  return mail(to, 'Welcome to TraderWorkStation!', text, html);
}
const receipt = o => 'Thank you for your order at Trader WorkStation.\n\n' +
  o.items.map(i => '- ' + i.name + ' x ' + i.quantity).join('\n') + '\n\nTotal: ' + money(o.amount) + (o.code ? ' (code ' + o.code + ')' : '') +
  '\n\nLicence keys:\n' + (o.licenses || []).map(l => '- ' + l.name + ': ' + l.key).join('\n') +
  '\n\nYour order page (downloads, keys and refund requests):\n' + (o.base || process.env.BASE_URL || '') + '/success.html?session_id=' + o.session_id +
  '\n\nFull refund within ' + REFUND_DAYS + ' days of payment. Keep this email.\n\nTrading involves substantial risk of loss. Educational use only, not financial advice.\n';

function markPaid(o, s) {
  if (o.status !== 'pending' && o.status !== 'expired') return;
  o.status = 'paid'; o.paid_at = now();
  o.payment_intent = typeof s.payment_intent === 'string' ? s.payment_intent : (s.payment_intent && s.payment_intent.id) || o.payment_intent || null;
  o.email = (s.customer_details && s.customer_details.email) || s.customer_email || o.email || '';
  o.licenses = [];
  for (const it of o.items) for (let i = 0; i < it.quantity; i++) o.licenses.push({ id: it.id, name: it.name, key: key16() });
  const c = o.code && db.codes.find(x => x.code === o.code); if (c) c.used = (c.used || 0) + 1;
  save();
  if (o.email) mail(o.email, 'Your Trader WorkStation order', receipt(o)).catch(() => { });
}
async function reconcile(o) {
  if (o.status !== 'pending' && o.status !== 'expired') return;
  try {
    const s = await stripe.checkout.sessions.retrieve(o.session_id);
    if (s.payment_status === 'paid') markPaid(o, s);
    else if (s.status === 'expired' && o.status === 'pending') { o.status = 'expired'; save(); }
  } catch (e) { console.error('reconcile failed:', e.message); }
}
const publicOrder = o => ({
  status: o.status, email: o.email, items: o.items, amount: o.amount, code: o.code || '', token: isPaidLike(o) ? o.token : null,
  licenses: isPaidLike(o) ? o.licenses || [] : [], refundable: refundable(o), refundUntil: o.paid_at ? refundUntil(o).toISOString() : null
});

// ---- cart, prices, discount codes ----
function cartItems(items) {
  if (!Array.isArray(items) || !items.length) return { error: 'Your cart is empty.' };
  const saved = [];
  for (const it of items) {
    const p = it && byId(it.id), q = it && it.quantity;
    if (!p || !Number.isInteger(q) || q < 1 || q > 10 || saved.some(s => s.id === p.id)) return { error: 'Invalid item in cart.' };
    saved.push({ id: p.id, name: p.name, quantity: q });
  }
  return { saved };
}
function findCode(raw) {
  if (!raw) return {};
  const c = db.codes.find(x => x.code === String(raw).trim().toUpperCase());
  if (!c || !c.active) return { error: 'That code is not valid.' };
  if (c.expires_at && new Date(c.expires_at) < new Date()) return { error: 'That code has expired.' };
  if (c.max_uses && (c.used || 0) >= c.max_uses) return { error: 'That code has been used up.' };
  return { code: c };
}
function priceCart(saved, code) {
  let subtotal = 0, total = 0; const lines = [];
  for (const s of saved) {
    const p = byId(s.id), base = Math.round(p.price * 100), unit = code ? Math.max(50, Math.round(base * (100 - code.percent) / 100)) : base;
    subtotal += base * s.quantity; total += unit * s.quantity;
    lines.push({ quantity: s.quantity, price_data: { currency: 'usd', unit_amount: unit, product_data: { name: p.name, description: p.tagline } } });
  }
  return { lines, subtotal, total };
}

const app = express();
app.set('trust proxy', 1);
app.use(cookieParser());

// ---- optional Stripe webhook (raw body, before express.json) ----
app.post('/api/webhook', express.raw({ type: '*/*' }), (req, res) => {
  const secret = process.env.STRIPE_WEBHOOK_SECRET;
  if (!secret) return res.status(404).json({ error: 'Not enabled' });
  let ev;
  try { ev = stripe.webhooks.constructEvent(req.body, req.get('stripe-signature'), secret); } catch { return res.status(400).json({ error: 'Bad signature' }); }
  const t = ev.type, obj = ev.data.object;
  if (t === 'checkout.session.completed' || t === 'checkout.session.async_payment_succeeded') {
    const o = db.orders.find(x => x.session_id === obj.id); if (o && obj.payment_status === 'paid') markPaid(o, obj);
  } else if (t === 'charge.refunded' && obj.refunded) {
    const o = db.orders.find(x => x.payment_intent === obj.payment_intent); if (o) { o.status = 'refunded'; save(); }
  }
  res.json({ received: true });
});

app.use(express.json({ limit: '50kb' }));
const err = (res, code, msg) => res.status(code).json({ error: msg });

// ---- public API ----
app.get('/api/config', (req, res) => res.json({ refundDays: REFUND_DAYS }));
app.get('/api/products', (req, res) => res.json(products));
const postCard = p => ({ slug: p.slug, title: p.title, category: p.category, excerpt: p.excerpt, image: p.image, date: p.date, readMin: p.readMin });
app.get('/api/posts', (req, res) => res.json(db.posts.filter(p => p.published).sort((a, b) => b.date.localeCompare(a.date)).map(postCard)));
app.get('/api/posts/:slug', (req, res) => {
  const p = db.posts.find(x => x.slug === req.params.slug && x.published);
  p ? res.json(Object.assign(postCard(p), { body: p.body })) : err(res, 404, 'Not found');
});

app.post('/api/discount', (req, res) => {
  const ci = cartItems((req.body || {}).items); if (ci.error) return err(res, 400, ci.error);
  const f = findCode((req.body || {}).code); if (f.error || !f.code) return err(res, 400, f.error || 'Enter a code.');
  const pr = priceCart(ci.saved, f.code);
  res.json({ ok: true, code: f.code.code, percent: f.code.percent, subtotal: pr.subtotal, total: pr.total });
});

app.post('/api/checkout', async (req, res) => {
  const ci = cartItems((req.body || {}).items); if (ci.error) return err(res, 400, ci.error);
  const f = findCode((req.body || {}).code); if (f.error) return err(res, 400, f.error);
  const pr = priceCart(ci.saved, f.code);
  try {
    const b = baseUrl(req);
    const session = await stripe.checkout.sessions.create({ mode: 'payment', line_items: pr.lines, success_url: b + '/success.html?session_id={CHECKOUT_SESSION_ID}', cancel_url: b + '/cancel.html' });
    db.orders.push({ id: ++db.seq, session_id: session.id, token: crypto.randomBytes(16).toString('hex'), payment_intent: null, email: '', amount: pr.total, status: 'pending', items: ci.saved, licenses: [], code: f.code ? f.code.code : '', discount: pr.subtotal - pr.total, base: b, refund_reason: '', admin_note: '', created_at: now(), paid_at: null });
    save(); res.json({ url: session.url });
  } catch (e) { console.error('checkout failed:', e.message); err(res, 500, 'Payment could not be started. Please try again.'); }
});

app.get('/api/order', async (req, res) => {
  const o = db.orders.find(x => x.session_id === req.query.session_id);
  if (!o) return err(res, 404, 'Order not found');
  await reconcile(o); res.json(publicOrder(o));
});

app.get('/download/:token/:id', (req, res) => {
  const o = db.orders.find(x => x.token === req.params.token);
  if (!o || !isPaidLike(o)) return res.status(403).send('Download not available.');
  const p = byIdOrAlias(req.params.id);
  if (!p || !o.items.some(i => i.id === p.id)) return res.status(404).send('Not found.');
  for (const n of [p.id, p.alias]) for (const ext of ['pdf', 'zip']) { const f = path.join(DL, n + '.' + ext); if (n && fs.existsSync(f)) return res.download(f, p.id + '.' + ext); }
  res.attachment(p.id + '-readme.txt').type('text/plain').send('The file for "' + p.name + '" has not been uploaded yet. Please contact support and quote your order link.\n');
});

app.post('/api/refund', (req, res) => {
  const o = db.orders.find(x => x.session_id === (req.body || {}).session_id);
  if (!o) return err(res, 404, 'Order not found');
  if (!refundable(o)) return err(res, 400, 'Refunds are possible within ' + REFUND_DAYS + ' days of payment.');
  o.status = 'refund_requested'; o.refund_reason = String((req.body || {}).reason || '').slice(0, 500); save(); res.json({ ok: true });
});

const hits = new Map();
const limited = (key, max) => { const t = Date.now(), l = (hits.get(key) || []).filter(x => t - x < 36e5); if (l.length >= max) return true; l.push(t); hits.set(key, l); return false; };
const validEmail = e => e.length <= 200 && /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e);

// ---- live sessions: the owner sets the date and time in the admin ----
const sessEnd = x => new Date(new Date(x.start).getTime() + (x.durationMin || 60) * 6e4);
const regsOf = x => db.inbox.filter(m => m.kind === 'live' && m.sessionId === x.id);
const activeSession = () => db.sessions.filter(x => !x.cancelled && sessEnd(x) > new Date()).sort((a, b) => a.start.localeCompare(b.start))[0] || null;
const validTz = tz => { try { new Intl.DateTimeFormat('en-US', { timeZone: tz }); return true; } catch { return false; } };
const whenText = x => new Date(x.start).toLocaleString('en-US', { timeZone: validTz(x.tz) ? x.tz : 'UTC', weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' });
const spotsLeft = x => x.capacity ? Math.max(0, x.capacity - regsOf(x).length) : null;
const sessOpen = x => !!x && x.open !== false && (spotsLeft(x) === null || spotsLeft(x) > 0);
const liveText = () => {
  const x = activeSession();
  if (!x) return 'No live session is scheduled right now. Leave your details with the Reserve my spot form on the home page (/#live) and we email you when the next one is set.';
  return `The next live session is "${x.title}" on ${whenText(x)} (about ${x.durationMin || 60} minutes).${x.description ? ' ' + x.description : ''} ${sessOpen(x) ? 'Register with the Reserve my spot form on the home page (/#live); we email the link before it starts.' : 'Registration for this session is closed or full.'}`;
};
app.get('/api/live', (req, res) => {
  res.set('Cache-Control', 'no-store');
  const x = activeSession(); if (!x) return res.json({ state: 'none' });
  res.json({ state: new Date() >= new Date(x.start) ? 'live' : 'scheduled', session: { title: x.title, start: x.start, end: sessEnd(x).toISOString(), tz: x.tz, when: whenText(x), description: x.description || '', capacity: x.capacity || null, spotsLeft: spotsLeft(x), open: sessOpen(x) } });
});

app.get('/api/config', (req, res) => {
  res.json({
    refundDays: REFUND_DAYS,
    googleClientId: process.env.GOOGLE_CLIENT_ID || ''
  });
});

app.get('/api/session', (req, res) => {
  res.set('Cache-Control', 'no-store');
  const x = activeSession();
  if (!x) return res.json(null);
  res.json({
    title: x.title,
    startsAt: x.start,
    endsAt: sessEnd(x).toISOString(),
    when: whenText(x),
    description: x.description || '',
    spots: x.capacity || null,
    spotsLeft: spotsLeft(x),
    registrationOpen: sessOpen(x)
  });
});

app.post('/api/session/register', (req, res) => {
  const b = req.body || {};
  if (b.website) return res.json({ ok: true });
  if (limited('in:' + req.ip, 5)) return err(res, 429, 'Too many messages. Please try again later.');
  const name = String(b.name || '').trim(), email = String(b.email || '').trim(), message = String(b.message || '').trim();
  if (!name || name.length > 100 || !validEmail(email) || !message || message.length > 2000) return err(res, 400, 'Please fill in every field with a valid email address.');
  const sess = activeSession();
  if (sess && regsOf(sess).some(m => m.email.toLowerCase() === email.toLowerCase())) return res.json({ ok: true });
  if (sess && !sessOpen(sess)) return err(res, 400, spotsLeft(sess) === 0 ? 'Sorry, this session is full.' : 'Registration for this session is closed.');
  db.inbox.push({ id: ++db.seq, kind: 'live', name, email, message, created_at: now(), sessionId: sess ? sess.id : null });
  save();
  const liveMsg = sess ? 'Thanks ' + name + ', your spot for "' + sess.title + '" is saved.\nWhen: ' + whenText(sess) + '\nWe will email the link before it starts.' : 'Thanks ' + name + ', you are on the list. We will email you when the next live session is scheduled.';
  mail(email, sess ? 'Your spot: ' + sess.title : 'You are on the live session list', liveMsg + '\n\nTrader WorkStation\n').catch(() => { });
  res.json({ ok: true });
});

// ---- Google Auth & JWT (MongoDB + HTTP-only cookie) ----
const JWT_SECRET = () => process.env.JWT_SECRET || 'tws-jwt-secret-98439284102';
const COOKIE_OPTS = {
  httpOnly: true,
  secure: process.env.NODE_ENV === 'production',
  sameSite: 'lax',
  maxAge: 7 * 24 * 60 * 60 * 1000 // 7 days
};

async function upsertMongoUser(sub, email, name, picture) {
  if (!mongoose.connection.readyState) return null;
  let user = await User.findOne({ $or: [{ googleId: sub }, { email }] });
  if (!user) {
    user = await User.create({ googleId: sub, email, name, picture });
  } else {
    let changed = false;
    if (!user.googleId) { user.googleId = sub; changed = true; }
    if (picture && user.picture !== picture) { user.picture = picture; changed = true; }
    if (name && user.name !== name) { user.name = name; changed = true; }
    if (changed) await user.save();
  }
  return user;
}

app.post('/api/auth/google', async (req, res) => {
  try {
    const { credential } = req.body || {};
    if (!credential) return err(res, 400, 'Missing credential');

    let payload = null;
    const clientId = process.env.GOOGLE_CLIENT_ID;

    if (clientId) {
      try {
        const { OAuth2Client } = require('google-auth-library');
        const client = new OAuth2Client(clientId);
        const ticket = await client.verifyIdToken({ idToken: credential, audience: clientId });
        payload = ticket.getPayload();
      } catch (verifyErr) {
        if (process.env.NODE_ENV === 'test' || process.env.STRIPE_MOCK_PORT) {
          try {
            const parts = credential.split('.');
            if (parts.length === 3) payload = JSON.parse(Buffer.from(parts[1], 'base64').toString('utf8'));
          } catch {}
        }
        if (!payload) throw verifyErr;
      }
    } else {
      try {
        const parts = credential.split('.');
        if (parts.length === 3) payload = JSON.parse(Buffer.from(parts[1], 'base64').toString('utf8'));
      } catch {}
    }

    if (!payload || (!payload.email_verified && payload.email_verified !== undefined)) {
      return err(res, 401, 'Email not verified by Google');
    }

    const sub     = payload.sub || payload.id || ('g_' + Date.now());
    const email   = String(payload.email || '').trim().toLowerCase();
    const name    = String(payload.name || payload.given_name || email.split('@')[0]).trim();
    const picture = payload.picture || '';

    if (!email || !validEmail(email)) return err(res, 400, 'Valid email not found in Google account');

    // ---- Persist to MongoDB (primary store) ----
    let mongoUser = null;
    try { mongoUser = await upsertMongoUser(sub, email, name, picture); } catch (e) { console.warn('Mongo upsert failed:', e.message); }

    // ---- Fallback / mirror: keep JSON store in sync ----
    let jsonUser = db.users.find(u => u.googleId === sub || (u.email && u.email.toLowerCase() === email));
    let isNewUser = false;
    if (!jsonUser) {
      jsonUser = { id: ++db.seq, googleId: sub, email, name, picture, created_at: now() };
      db.users.push(jsonUser); save(); isNewUser = true;
    } else {
      let changed = false;
      if (!jsonUser.googleId) { jsonUser.googleId = sub; changed = true; }
      if (picture && jsonUser.picture !== picture) { jsonUser.picture = picture; changed = true; }
      if (name && jsonUser.name !== name) { jsonUser.name = name; changed = true; }
      if (changed) save();
    }

    if (isNewUser) sendWelcomeEmail(email, name).catch(e => console.error('Welcome mail failed:', e.message));

    const jwt = require('jsonwebtoken');
    // Use MongoDB _id when available, fall back to JSON store id
    const userId = mongoUser ? mongoUser._id.toString() : String(jsonUser.id);
    const token = jwt.sign({ id: userId, email, name }, JWT_SECRET(), { expiresIn: '7d' });

    // Set HTTP-only cookie
    res.cookie('tws_auth', token, COOKIE_OPTS);

    res.json({
      token,  // also send in body for clients that prefer Bearer token
      isNewUser,
      user: { id: userId, name, email, picture }
    });
  } catch (e) {
    console.error('Google login failed:', e.message);
    res.status(401).json({ message: 'Google login failed: ' + e.message });
  }
});

// ---- /api/auth/me: check cookie first, then Authorization header ----
app.get('/api/auth/me', async (req, res) => {
  const cookieToken = req.cookies && req.cookies.tws_auth;
  const authHeader  = req.headers.authorization || '';
  const bearerToken = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : (req.query.token || '');
  const token = cookieToken || bearerToken;

  if (!token) return err(res, 401, 'Not authenticated');
  try {
    const jwt = require('jsonwebtoken');
    const decoded = jwt.verify(token, JWT_SECRET());

    // Try MongoDB first
    let userData = null;
    if (mongoose.connection.readyState) {
      try {
        const mongoUser = await User.findById(decoded.id).lean();
        if (mongoUser) {
          userData = { id: mongoUser._id.toString(), name: mongoUser.name, email: mongoUser.email, picture: mongoUser.picture || '' };
        }
      } catch {}
    }
    // Fallback to JSON store
    if (!userData) {
      const jsonUser = db.users.find(u => String(u.id) === String(decoded.id) || (u.email && u.email.toLowerCase() === (decoded.email || '').toLowerCase()));
      if (jsonUser) userData = { id: String(jsonUser.id), name: jsonUser.name, email: jsonUser.email, picture: jsonUser.picture || '' };
    }

    if (!userData) return err(res, 404, 'User not found');
    res.json({ user: userData });
  } catch (e) {
    res.clearCookie('tws_auth');
    err(res, 401, 'Invalid or expired session');
  }
});

// ---- /api/auth/logout ----
app.post('/api/auth/logout', (req, res) => {
  res.clearCookie('tws_auth', { httpOnly: true, sameSite: 'lax', secure: process.env.NODE_ENV === 'production' });
  res.json({ ok: true });
});

app.post('/api/inbox', (req, res) => {
  const b = req.body || {};
  if (b.website) return res.json({ ok: true }); // honeypot
  if (limited('in:' + req.ip, 5)) return err(res, 429, 'Too many messages. Please try again later.');
  const name = String(b.name || '').trim(), email = String(b.email || '').trim(), message = String(b.message || '').trim();
  if (!['live', 'contact'].includes(b.kind) || !name || name.length > 100 || !validEmail(email) || !message || message.length > 2000) return err(res, 400, 'Please fill in every field with a valid email address.');
  let sess = null;
  if (b.kind === 'live') {
    sess = activeSession();
    if (sess && regsOf(sess).some(m => m.email.toLowerCase() === email.toLowerCase())) return res.json({ ok: true }); // already registered
    if (sess && !sessOpen(sess)) return err(res, 400, spotsLeft(sess) === 0 ? 'Sorry, this session is full.' : 'Registration for this session is closed.');
  }
  db.inbox.push({ id: ++db.seq, kind: b.kind, name, email, message, created_at: now(), sessionId: sess ? sess.id : null }); save();
  const liveMsg = sess ? 'Thanks ' + name + ', your spot for "' + sess.title + '" is saved.\nWhen: ' + whenText(sess) + '\nWe will email the link before it starts.' : 'Thanks ' + name + ', you are on the list. We will email you when the next live session is scheduled.';
  mail(email, b.kind === 'live' ? (sess ? 'Your spot: ' + sess.title : 'You are on the live session list') : 'We received your message',
    (b.kind === 'live' ? liveMsg : 'Thanks ' + name + ', we received your message and will reply soon.') + '\n\nTrader WorkStation\n').catch(() => { });
  res.json({ ok: true });
});

// find my orders: emailed 30-minute link; the answer never reveals whether an email has orders
app.post('/api/lookup', (req, res) => {
  const email = String((req.body || {}).email || '').trim().toLowerCase();
  if (!validEmail(email)) return err(res, 400, 'Enter a valid email address.');
  if (limited('lk:' + req.ip, 5)) return err(res, 429, 'Too many requests. Please try again later.');
  if (db.orders.some(o => o.email.toLowerCase() === email && (isPaidLike(o) || o.status === 'refunded'))) {
    const t = crypto.randomBytes(20).toString('hex');
    db.lookups = db.lookups.filter(l => new Date(l.expires) > new Date()).concat({ token: t, email, expires: new Date(Date.now() + 30 * 6e4).toISOString() }); save();
    mail(email, 'Your Trader WorkStation orders', 'Open this link within 30 minutes to see your orders:\n' + baseUrl(req) + '/my-orders.html?t=' + t + '\n\nIf you did not ask for this, ignore this email.\n').catch(() => { });
  }
  res.json({ ok: true });
});
app.get('/api/my-orders', (req, res) => {
  const l = db.lookups.find(x => x.token === req.query.t && new Date(x.expires) > new Date());
  if (!l) return err(res, 404, 'This link has expired. Request a new one.');
  res.json(db.orders.filter(o => o.email.toLowerCase() === l.email && (isPaidLike(o) || o.status === 'refunded')).reverse()
    .map(o => ({ session_id: o.session_id, created_at: o.created_at, status: o.status, amount: o.amount, items: o.items })));
});

// ---- admin ----
const admin = (req, res, next) => {
  const t = (req.get('authorization') || '').replace(/^Bearer /, '');
  const a = Buffer.from(t), b = Buffer.from(ADMIN);
  if (a.length === b.length && crypto.timingSafeEqual(a, b)) return next();
  err(res, 401, 'Unauthorized');
};
app.get('/api/admin/orders', admin, async (req, res) => {
  for (const o of db.orders.filter(x => x.status === 'pending').slice(-20)) await reconcile(o);
  const counted = db.orders.filter(isPaidLike), today = now().slice(0, 10);
  res.json({
    totals: { orders: counted.length, cents: counted.reduce((n, o) => n + o.amount, 0), todayCents: counted.filter(o => (o.paid_at || '').startsWith(today)).reduce((n, o) => n + o.amount, 0) },
    pendingRefunds: db.orders.filter(o => o.status === 'refund_requested').length, messages: db.inbox.length, activeCodes: db.codes.filter(c => c.active).length, usersCount: (db.users || []).length, live: (() => { const x = activeSession(); return x ? { title: x.title, when: whenText(x), registrants: regsOf(x).length } : null; })(), stripeMode: process.env.STRIPE_MOCK_PORT ? 'test' : /^(sk|rk)_live_/.test(KEY) ? 'live' : 'test', tickerStocks: !!process.env.FINNHUB_API_KEY, tickerOff: process.env.TICKER === 'off',
    orders: db.orders.slice(-300).reverse().map(o => Object.assign({}, o, { items: JSON.stringify(o.items) }))
  });
});
app.get('/api/admin/users', admin, (req, res) => {
